rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['id', 'displayName', 'email']) &&
             data.keys().hasOnly(['id', 'displayName', 'email', 'photoUrl', 'createdAt', 'lastLogin']) &&
             data.id == userId &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200;
    }

    function isValidTransaction(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'amount', 'type', 'category', 'narration', 'source', 'timestamp']) &&
             data.keys().hasOnly(['id', 'userId', 'amount', 'type', 'category', 'narration', 'source', 'timestamp', 'bankName', 'reflection', 'createdAt']) &&
             data.userId == userId &&
             data.amount is number && data.amount >= 0 &&
             data.type in ['DEBIT', 'CREDIT'] &&
             data.category is string && data.category.size() <= 64 &&
             data.narration is string && data.narration.size() <= 500 &&
             data.source in ['MANUAL', 'SMS', 'STATEMENT'] &&
             data.timestamp is number;
    }

    function isValidReflection(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'reflection', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'userId', 'reflection', 'updatedAt']) &&
             data.userId == userId &&
             data.reflection in ['NEED', 'WANT'] &&
             data.updatedAt is number;
    }

    // User profiles - only the authenticated owner can read or write
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users cannot be enumerated
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUser(request.resource.data, userId);
      allow delete: if isOwner(userId);

      // User transactions subcollection
      match /transactions/{transactionId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidTransaction(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      // User reflections subcollection
      match /reflections/{reflectionId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(reflectionId) && isValidReflection(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidReflection(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
